{
  "name": "diplom",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep @critical",
    "test:tag": "playwright test --grep",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:clean": "node -e \"const fs=require('fs');fs.rmSync('allure-results',{recursive:true,force:true});fs.rmSync('allure-report',{recursive:true,force:true});\"",
    "allure:clean:results": "node -e \"const fs=require('fs');fs.rmSync('allure-results',{recursive:true,force:true});\"",
    "allure:clean:report": "node -e \"const fs=require('fs');fs.rmSync('allure-report',{recursive:true,force:true});\"",
    "test:allure": "npm run test && npm run allure:generate && npm run allure:open",
    "test:allure:fresh": "npm run allure:clean:results && npm run test && npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.1.0",
    "allure": "^3.0.0",
    "allure-commandline": "^2.36.0",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^17.3.1"
  }
}
